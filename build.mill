//| mill-version: 1.3.1
//| mill-jvm-version: temurin:17
//| mvnDeps: ["com.lihaoyi::mill-contrib-jmh:$MILL_VERSION"]

// The whole build, for Mill (https://mill-build.org). `./mill` downloads Mill and a Java 17 the
// first time; nothing else needs installing, apart from clang for Scala Native.
//
//   core   the pure library: arithmetic, cuboids, the searches. Built for the JVM, JavaScript
//          and Scala Native, with one set of tests run on all three.
//   cli    the command line, hunts, files and reports, on Cats Effect and fs2: the JVM, and
//          Scala Native for the release executable.
//   web    the page in docs/check, the core compiled to JavaScript.
//   bench  JMH microbenchmarks of the search's kernels.
//   api    the API docs of core and cli together.
//
// Each module takes whole directories, so no file list can fall out of step with the code.
package build

import mill.*, scalalib.*, scalajslib.*, scalanativelib.*, publish.*
import mill.scalanativelib.api.ReleaseMode
import mill.contrib.jmh.JmhModule

/** What every module shares: the Scala version, and a strict compiler. */
trait Strict extends ScalaModule:
  def scalaVersion = "3.9.0"

  // Every warning is an error (-Werror); unused code, discarded values and ignored results
  // are warnings; reading a field before it is set is caught (-Wsafe-init); and `null` is not
  // a value of every type, only of `T | Null` (-Yexplicit-nulls).
  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-Werror",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Wsafe-init",
    "-Yexplicit-nulls"
  )

/** Published to the local Ivy repository by `./mill __.publishLocal`, for the worksheets in
  * docs/tour, which use the library as a dependency like any other.
  */
trait Published extends PublishModule:
  def publishVersion = "3.0.0-SNAPSHOT"
  def pomSettings = PomSettings(
    description = "Looking for a perfect cuboid, in purely functional Scala 3",
    organization = "io.github.drunkmonoid",
    url = "https://github.com/drunkmonoid/perfectcuboid",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("drunkmonoid", "perfectcuboid"),
    developers = Seq(Developer("drunkmonoid", "Drunk Monoid", "https://github.com/drunkmonoid"))
  )

/** The tests' framework: munit, with ScalaCheck for properties. */
trait Munit extends TestModule.Munit:
  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"org.scalameta::munit::1.3.6",
    mvn"org.scalameta::munit-scalacheck::1.3.1"
  )

trait Js extends ScalaJSModule:
  def scalaJSVersion = "1.22.0"

trait Native extends ScalaNativeModule:
  def scalaNativeVersion = "0.5.12"

object core extends Module:
  trait Shared extends Strict, PlatformScalaModule, Published:
    def artifactName = "perfectcuboid-core"

  object jvm extends Shared:
    object test extends ScalaTests, Munit

  object js extends Shared, Js:
    object test extends ScalaJSTests, Munit

  object native extends Shared, Native:
    object test extends ScalaNativeTests, Munit:
      // Unoptimised, two of the tests take longer than munit allows.
      def releaseMode = ReleaseMode.ReleaseFast

object cli extends Module:
  trait Shared extends Strict, PlatformScalaModule, Published:
    def artifactName = "perfectcuboid-cli"
    def mainClass = Some("perfectcuboid.Main")
    def mvnDeps = Seq(
      mvn"org.typelevel::cats-effect::3.7.1",
      mvn"co.fs2::fs2-io::3.14.0",
      mvn"com.monovore::decline-effect::2.6.2"
    )

  object jvm extends Shared:
    def moduleDeps = Seq(core.jvm)

    object test extends ScalaTests, Munit:
      def moduleDeps = super.moduleDeps ++ Seq(core.jvm.test)
      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.typelevel::munit-cats-effect::2.2.1",
        mvn"org.typelevel::discipline-munit::2.0.0",
        mvn"org.typelevel::cats-kernel-laws::2.13.0"
      )

  /** The native executable of the releases: `./mill cli.native.nativeLink`. */
  object native extends Shared, Native:
    def moduleDeps = Seq(core.native)
    def releaseMode = ReleaseMode.ReleaseFast

/** The page in docs/check. Build it with `./mill web.fullLinkJS` and copy
  * out/web/fullLinkJS.dest/main.js to docs/check/main.js.
  */
object web extends Strict, Js:
  def moduleDeps = Seq(core.js)
  def mvnDeps = Seq(mvn"org.scala-js::scalajs-dom::2.8.1")

  object test extends ScalaJSTests, Munit

/** Run with `./mill bench.runJmh`, on a quiet machine; `./mill bench.runJmh isqrtLong` runs
  * those whose names match.
  */
object bench extends Strict, JmhModule:
  def jmhCoreVersion = "1.37"
  def moduleDeps = Seq(cli.jvm)

/** Checks the certificates of `perfectcuboid certificates` with code of its own: it depends on
  * nothing else in the project. `./mill checker.run docs/local-certificates.txt`.
  */
object checker extends Strict:
  def mainClass = Some("checker.Checker")

  object test extends ScalaTests, Munit

/** The speed guard: `./mill speed.run`, and `./mill speed.run --check` in CI (speed/src/Guard.scala). */
object speed extends Strict:
  def moduleDeps = Seq(core.jvm)
  def mainClass = Some("perfectcuboid.speed.Guard")

  object test extends ScalaTests, Munit

/** The API docs: `./mill api.docJar`, then the HTML is in out/api/docJar.dest/javadoc. */
object api extends Strict:
  def sources = Task { core.jvm.sources() ++ cli.jvm.sources() }
  def mvnDeps = cli.jvm.mvnDeps
  def scalaDocOptions = Seq("-project", "perfectcuboid")
